node_modules/
.claude/
*.log
.DS_Store
.env

# Local HA dev environment: keep configuration.yaml + bundled blueprints,
# ignore the rest (HA runtime DB, storage/, secrets, logs)
ha-config/*
!ha-config/configuration.yaml
!ha-config/.gitkeep
!ha-config/blueprints/
ha-config/blueprints/*
!ha-config/blueprints/automation/
ha-config/blueprints/automation/*
!ha-config/blueprints/automation/jewon-oh/
!ha-config/dashboards/
!ha-config/dashboards/**

# The user's live Lovelace dashboard. This is a personal working copy mirrored
# from the live HA instance (which is the source of truth) — it must never be
# committed to this repo. Version control for it lives in a separate private
# repo. Untracked deliberately: see the "release:" history for when it left.
ha_dashboard.yaml

# Local dashboard transform backups (scripts/*-ui.js and live-sync snapshots)
ha_dashboard.yaml.bak
ha_dashboard.yaml.before-*
ha_*backup*.json
